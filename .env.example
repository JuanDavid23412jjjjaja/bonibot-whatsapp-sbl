# ============================================================================
# 1. PROVEEDORES DE LLM (Configura al menos UNO; el router usará fallback)
# ============================================================================

# Google AI Studio (Gratis: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq Cloud (Gratis: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (Gratis en modelos :free: https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# NVIDIA NIM API (Gratis con créditos de prueba: https://build.nvidia.com/)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# ============================================================================
# 2. SUPABASE (Opcional en local; recomendado para Producción Serverless)
# ============================================================================
# Si se dejan vacíos en local, el bot usa automáticamente data/knowledge_base.json
# y memoria en disco/RAM para que puedas probar de inmediato.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# 3. META WHATSAPP CLOUD API (Para Fase 4 - Conexión con WhatsApp Real)
# ============================================================================
WHATSAPP_VERIFY_TOKEN=bonibot_sbl_2026_secreto
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ============================================================================
# 4. GOOGLE SHEETS EN VIVO (Opcional - URL pública CSV)
# ============================================================================
GOOGLE_SHEETS_CSV_URL=
